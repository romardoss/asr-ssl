HF_TOKEN=
LD_LIBRARY_PATH=path/to/your/cuda/lib64
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
# Judge backend: true sends each transcript to OPENROUTER_DECISION_MODEL through the Decisions API
# (decisions.py) instead of the chat model. The same OPENROUTER_API_KEY is used.
USE_DECISION_INSTEAD_OF_LLM=false
OPENROUTER_DECISION_MODEL=

# Whisper live check notebook (evaluation/live_check.ipynb)
WHISPER_SSH_HOST=user@server
WHISPER_SSH_PORT=22
WHISPER_REMOTE_CKPT=/path/to/model-epoch04.ckpt
