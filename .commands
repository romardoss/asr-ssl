cd /mnt/data/rberehun
cd /mnt/data/rberehun/checkpoints && ls

source env/bin/activate
python main.py pipeline

git add . && git commit -m "" && git push
# Видалити проміжні чекпоінти (*-epochNN-batchXXpct.ckpt) у теці. Лишаються *-epochNN.ckpt і last.ckpt.
# Якщо last.ckpt вказує на проміжний чекпоінт, запуск не завершено, і нічого не видаляється.
DIR=/mnt/data/rberehun/checkpoints/model-whisper-uk_01
ls -lh "$DIR"/*-epoch[0-9][0-9]-batch[0-9]*pct.ckpt && du -sh "$DIR"   # що буде видалено
case "$(readlink "$DIR/last.ckpt")" in *-batch*pct.ckpt) echo "last.ckpt -> проміжний чекпоінт, не видаляю";; *) rm -v "$DIR"/*-epoch[0-9][0-9]-batch[0-9]*pct.ckpt && du -sh "$DIR";; esac
